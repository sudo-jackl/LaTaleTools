<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
      <UserSecretsId>61eb63fb-8034-44df-a708-0c7647b8ebe2</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <Compile Include="Logging.fs" />
        <Compile Include="AppState.fs" />
        <Compile Include="Route.fs" />
        <Compile Include="Config.fs" />
        <Compile Include="Views.fs" />
        <Compile Include="FileViews\LdtView.fs" />
        <Compile Include="FileViews\TblExplanation.fs" />
        <Compile Include="FileViews\TblView.fs" />
        <Compile Include="FileViews\AudioView.fs" />
        <Compile Include="Handlers.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="FileViews\TblExplanation.html" LogicalName="LaTaleTools.WebApp.FileViews.TblExplanation.html" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\LaTaleTools.Library\LaTaleTools.Library.fsproj" />
      <ProjectReference Include="..\submodules\Giraffe.ViewEngine\src\Giraffe.ViewEngine\Giraffe.ViewEngine.fsproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Giraffe" Version="8.3.0" />
      <PackageReference Include="TagLibSharp" Version="2.3.0" />
      <!-- SkiaSharp already supplies Windows/macOS assets; add Linux assets for runtime-based selection. -->
      <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.0" />
    </ItemGroup>

</Project>
